{
  "manifest_version": 3,
  "name": "GRabbit - High-Speed Download Companion",
  "version": "1.1.0",
  "description": "High-performance download interceptor and video sniffer companion for GRabbit desktop.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "GRabbit Companion"
  },
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/index.js"],
      "css": ["content/styles.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options/index.html",
  "permissions": [
    "downloads",
    "contextMenus",
    "storage",
    "activeTab",
    "tabs",
    "scripting",
    "cookies",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "<all_urls>"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "grabbit-companion@grabbit.app",
      "strict_min_version": "109.0"
    }
  }
}

