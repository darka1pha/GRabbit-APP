{
  "name": "@grabbit/mobile",
  "version": "1.2.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:assets": "node scripts/make-assets.mjs",
    "export": "expo export",
    "prebuild:android": "node scripts/make-assets.mjs && expo prebuild --platform android --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --test-timeout=15000",
    "lint": "echo 'No linter configured for mobile yet'"
  },
  "dependencies": {
    "@babel/runtime": "^7.26.0",
    "@expo/metro-runtime": "~4.0.1",
    "@expo/vector-icons": "~14.0.4",
    "@grabbit/api": "workspace:*",
    "@grabbit/config": "workspace:*",
    "@grabbit/core": "workspace:*",
    "@grabbit/schemas": "workspace:*",
    "@grabbit/types": "workspace:*",
    "@grabbit/utils": "workspace:*",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-av": "~15.0.2",
    "expo-clipboard": "~7.0.1",
    "expo-constants": "~17.0.0",
    "expo-file-system": "~18.0.12",
    "expo-font": "~13.0.4",
    "expo-haptics": "~14.0.1",
    "expo-linking": "~7.0.0",
    "expo-media-library": "~17.0.6",
    "expo-modules-autolinking": "~2.0.8",
    "expo-modules-core": "~2.2.3",
    "expo-notifications": "~0.29.14",
    "expo-router": "~4.0.0",
    "expo-status-bar": "~2.0.0",
    "expo-system-ui": "~4.0.9",
    "query-string": "^7.1.3",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "typescript": "^5.8.2",
    "vitest": "^5.1.0"
  }
}
