{
  "name": "@grabbit/mobile",
  "version": "1.4.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:assets": "node scripts/make-assets.mjs",
    "export": "expo export",
    "prebuild:android": "node scripts/make-assets.mjs && expo prebuild --platform android --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --test-timeout=15000",
    "lint": "eslint ."
  },
  "dependencies": {
    "@babel/runtime": "^8.1.2",
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "~15.1.1",
    "@grabbit/api": "workspace:*",
    "@grabbit/config": "workspace:*",
    "@grabbit/core": "workspace:*",
    "@grabbit/schemas": "workspace:*",
    "@grabbit/types": "workspace:*",
    "@grabbit/utils": "workspace:*",
    "expo": "~58.0.26",
    "expo-asset": "~58.0.21",
    "expo-audio": "~58.0.12",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-intent-launcher": "~58.0.3",
    "expo-linking": "~58.0.17",
    "expo-media-library": "~58.0.14",
    "expo-modules-autolinking": "~58.1.0",
    "expo-modules-core": "~58.1.0",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.32",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-video": "~58.0.14",
    "query-string": "^10.0.0",
    "react": "19.3.1",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "~4.30.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
