{
  "expo": {
    "name": "GRabbit",
    "slug": "grabbit-mobile",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "grabbit",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.grabbit.mobile",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "GRabbit needs access to your photos to save downloaded videos and audio.",
        "NSPhotoLibraryAddUsageDescription": "GRabbit needs permission to save downloaded media to your library."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "package": "com.grabbit.mobile",
      "permissions": [
        "READ_MEDIA_AUDIO",
        "READ_MEDIA_VIDEO",
        "READ_MEDIA_IMAGES",
        "WRITE_EXTERNAL_STORAGE",
        "INTERNET"
      ],
      "intentFilters": [
        {
          "action": "SEND",
          "data": [
            {
              "mimeType": "text/plain"
            }
          ],
          "category": [
            "DEFAULT"
          ]
        }
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow GRabbit to access your photos.",
          "savePhotosPermission": "Allow GRabbit to save media to your photos.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "./plugins/withAndroidFixes"
    ]
  }
}

