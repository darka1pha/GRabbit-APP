{
  "expo": {
    "name": "gRabbit",
    "slug": "grabbit-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "grabbit",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.grabbit.mobile",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "gRabbit needs access to your photos to save downloaded videos and audio.",
        "NSPhotoLibraryAddUsageDescription": "gRabbit needs permission to save downloaded media to your library."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f172a"
      },
      "package": "com.grabbit.mobile",
      "permissions": [
        "READ_MEDIA_AUDIO",
        "READ_MEDIA_VIDEO",
        "READ_MEDIA_IMAGES",
        "WRITE_EXTERNAL_STORAGE",
        "INTERNET"
      ],
      "intentFilters": [
        {
          "action": "SEND",
          "data": [
            {
              "mimeType": "text/plain"
            }
          ],
          "category": [
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "grabbit"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow gRabbit to access your photos.",
          "savePhotosPermission": "Allow gRabbit to save media to your photos.",
          "isAccessMediaLocationEnabled": true
        }
      ]
    ]
  }
}

