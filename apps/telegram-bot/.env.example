# ==============================================================================
# g(Rabbit) — Environment Configuration Example
# ==============================================================================

# Application environment (development | production | test)
NODE_ENV=development

# Telegram Bot API Token obtained from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Database connection URL (PostgreSQL)
# When running locally with docker compose backing services: port 54320
DATABASE_URL=postgresql://postgres:postgres@localhost:54320/grabbit

# Redis connection URL (BullMQ queue backend)
# When running locally with docker compose backing services: port 63790
REDIS_URL=redis://localhost:63790

# Logging level (trace | debug | info | warn | error | fatal)
LOG_LEVEL=info

# Default language for unconfigured users (en | fa)
DEFAULT_LANGUAGE=en

# Comma-separated list of supported language codes
SUPPORTED_LANGUAGES=en,fa

# Media processing & download limits
MAX_FILE_SIZE_MB=2000
MAX_MEDIA_DURATION_SECONDS=3600
MAX_CONCURRENT_JOBS_PER_USER=2
MAX_GLOBAL_WORKERS=5
JOB_TIMEOUT_SECONDS=600

# Storage & Temporary Files
TEMP_DIR=./temp
TEMP_FILE_TTL_MINUTES=30

# Comma-separated list of Telegram User IDs with administrative privileges
ADMIN_USER_IDS=

# Executable paths (defaults to system PATH lookup if omitted)
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Optional Platform Credentials (where authorized API access is used)
# Spotify Web API: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Instagram session cookie (for authorized access to age-gated/public posts if needed)
INSTAGRAM_SESSION_ID=

# YouTube cookies file (optional Netscape format cookies.txt to bypass bot detection/age-gate)
YOUTUBE_COOKIES_FILE=

# DB Variables
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=grabbit

# Local Telegram Bot API Server (Enables uploads up to 2000MB / 2GB)
# Get api_id and api_hash for free from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# When running with Docker Compose: http://telegram-bot-api:8081
# When running locally on host: http://localhost:8081
TELEGRAM_API_ROOT=http://telegram-bot-api:8081
