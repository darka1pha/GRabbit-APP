{
  "name": "@grabbit/telegram-bot",
  "version": "1.0.0",
  "description": "gRabbit Telegram Bot backend service",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src || echo 'Lint skipped'",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:translations": "tsx scripts/validate-translations.ts"
  },
  "dependencies": {
    "@grammyjs/i18n": "^1.1.2",
    "@grabbit/core": "workspace:*",
    "@grabbit/types": "workspace:*",
    "bullmq": "^6.4.2",
    "dotenv": "^18.0.9",
    "grammy": "^1.46.0",
    "ioredis": "^6.0.0",
    "node-shazam": "^1.2.7",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "eslint": "^10.13.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
