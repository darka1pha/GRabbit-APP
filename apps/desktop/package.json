{
  "name": "grabbit-desktop",
  "productName": "GRabbit",
  "version": "1.2.1",
  "description": "g(Rabbit) for Windows: media grabber, music recognizer and multi-connection download manager. Runs 100% locally.",
  "main": "out/main/index.js",
  "author": "DarkAlpha",
  "license": "MIT",
  "private": true,
  "scripts": {
    "fetch-binaries": "node scripts/fetch-binaries.mjs",
    "icon": "node scripts/make-icon.mjs",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "echo desktop lint ok",
    "test": "vitest run",
    "dist": "node scripts/make-icon.mjs && node scripts/fetch-binaries.mjs && electron-vite build && electron-builder --win --x64 --publish never",
    "dist:dir": "node scripts/make-icon.mjs && node scripts/fetch-binaries.mjs && electron-vite build && electron-builder --win --x64 --dir"
  },
  "devDependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^1.70.0",
    "motion": "^14.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@grabbit/config": "workspace:*",
    "@grabbit/core": "workspace:*",
    "@grabbit/schemas": "workspace:*",
    "@grabbit/types": "workspace:*",
    "@grabbit/utils": "workspace:*",
    "electron-updater": "^6.8.11",
    "qrcode": "^1.5.4",
    "shazamio-core": "^1.3.1"
  }
}
