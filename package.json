{
  "name": "grabbit-monorepo",
  "version": "1.2.1",
  "private": true,
  "description": "GRabbit - Media Grabber & Download Manager Monorepo",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint && eslint docs scripts eslint.config.mjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test -- --coverage.enabled --coverage.reporter=text-summary --coverage.reporter=json-summary && node scripts/coverage-summary.mjs",
    "clean": "turbo run clean",
    "build:desktop": "pnpm --filter grabbit-desktop dist",
    "build:desktop:dir": "pnpm --filter grabbit-desktop dist:dir",
    "build:mobile:assets": "pnpm --filter @grabbit/mobile build:assets",
    "build:mobile:export": "pnpm --filter @grabbit/mobile export",
    "build:extension": "pnpm --filter @grabbit/extension build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "turbo": "^2.11.11",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.72.2"
  }
}
