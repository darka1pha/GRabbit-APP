{
  "name": "grabbit-monorepo",
  "version": "1.2.0",
  "private": true,
  "description": "GRabbit - Media Grabber & Download Manager Monorepo",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "build:desktop": "pnpm --filter grabbit-desktop dist",
    "build:desktop:dir": "pnpm --filter grabbit-desktop dist:dir",
    "build:mobile:assets": "pnpm --filter @grabbit/mobile build:assets",
    "build:mobile:export": "pnpm --filter @grabbit/mobile export",
    "build:extension": "pnpm --filter @grabbit/extension build"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.8.2"
  }
}
